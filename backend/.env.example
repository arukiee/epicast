# EPICAST — Backend environment variables
# Copy this to .env and fill in your values

# Database (default: SQLite; for production you can use PostgreSQL)
DATABASE_URL=sqlite:///./epicast.db

# JWT Signing Secret — CHANGE THIS to a long random string before deploying
EPICAST_SECRET_KEY=your-jwt-signing-secret-key-change-this

# Environment: "development" | "production"
EPICAST_ENV=production

# Frontend public URL (used in verification email links)
APP_PUBLIC_URL=https://your-frontend-domain.railway.app

# ── Email delivery ─────────────────────────────────────────────────────────────
# Option A: Gmail SMTP (free, no domain required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=Epicast <your-gmail@gmail.com>
SMTP_TLS=True
SMTP_SSL=False
EMAIL_ALLOW_CONSOLE_FALLBACK=false

# Option B: Resend API (optional — leave blank to use SMTP above)
RESEND_API_KEY=
RESEND_FROM=Epicast <onboarding@resend.dev>
